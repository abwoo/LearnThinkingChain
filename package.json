{
  "name": "learnthinkingchain",
  "version": "3.0.0",
  "description": "Cognitive Process Emulator for Gemini - Production Internal Edition",
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/extension/vite.config.ts",
    "build": "vite build --config apps/extension/vite.config.ts",
