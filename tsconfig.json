{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "types": ["chrome", "vite/client", "node"],
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@infra/*": ["src/infra/*"],
      "@ui/*": ["src/ui/*"],
      "@shared/*": ["packages/shared/*"]
    }
  },
  "include": ["src/**/*", "apps/**/*", "packages/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "release",
    "src/app/**",
    "apps/**/integration-example.*",
    "apps/web/dashboard.js",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
